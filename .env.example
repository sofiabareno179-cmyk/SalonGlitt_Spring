# Copia este archivo a `.env` y ajusta los valores según tu entorno.
# Este `.env.example` NO contiene secretos; usa los valores de ejemplo.

# Puerto en el que escucha la aplicación
SERVER_PORT=8082

# --- Configuración de base de datos ---
# La aplicación lee estas variables (ver src/main/resources/application.properties):
#   spring.datasource.url=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}
# En local se suele usar un túnel SSH hacia la base remota (p. ej. localhost:500).
DB_HOST=localhost
DB_PORT=
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
